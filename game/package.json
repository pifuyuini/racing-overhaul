{
  "name": "pawprint-paradise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "qa": "node scripts/browser-qa.mjs",
    "format": "prettier --write src test scripts index.html package.json tsconfig.json README.md VALIDATION.md",
    "format:check": "prettier --check src test scripts index.html package.json tsconfig.json README.md VALIDATION.md"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
